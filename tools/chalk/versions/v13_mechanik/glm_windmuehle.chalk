canvas dark
title "Holländische Windmühle – Getriebe im Schnitt"
model obj 1100 620 keep=1 tidy=1 view=35,18 cut=z>0

  group whole
    group hull shell=1
      # Brick base of the mill (tapered, slight plinth flare at the bottom)
      lathe base pts=0,3.8 0.15,3.85 0.35,3.6 1.8,3.45 3.0,3.35 3.2,3.3 axis=y smooth=1 mat=paint color=#9c6b53
      # Smock: octagonal tarred timber body, strong taper up to the cap
      lathe smock pts=3.1,3.32 4.2,3.1 5.4,2.9 6.6,2.65 7.8,2.4 9.0,2.15 axis=y smooth=1 mat=paint color=#2e2620
      # Stage / gallery deck ringing the mill at the top of the brick base
      lathe gallery pts=3.15,4.75 3.35,4.75 axis=y mat=paint color=#6b4a32
      # Gallery railing ring
      lathe rail pts=4.2,4.75 4.42,4.75 axis=y mat=paint color=#3a2c22
      # Cap: onion-shaped dome, bulging forward over the smock top, closing to a point
      lathe cap pts=8.9,2.05 9.3,2.5 10.0,2.75 10.8,2.6 11.5,1.9 12.1,1.0 12.5,0.35 12.65,0.02 axis=y smooth=1 mat=paint color=#26201a
      # --- livery ---
      # white trim band where cap meets smock
      paint smock color=#e8e2d5 box=-3.0,8.55,-3.0,3.0,9.0,3.0
      paint cap color=#e8e2d5 box=-3.0,8.9,-3.0,3.0,9.3,3.0
      # door in the brick base, facing the front (-x)
      paint base color=#3a2418 box=-3.95,0,-0.85,-3.2,2.2,0.85
      # small leaded windows up the smock, front and back
      paint smock mat=glass poly=-2.0,4.3 -1.4,4.3 -1.4,5.0 -2.0,5.0 axis=z both=1
      paint smock mat=glass poly=-1.7,6.1 -1.15,6.1 -1.15,6.75 -1.7,6.75 axis=z both=1
      paint smock mat=glass poly=-1.45,7.4 -0.95,7.4 -0.95,8.0 -1.45,8.0 axis=z both=1
      paint smock mat=glass poly=0.6,4.6 1.2,4.6 1.2,5.2 0.6,5.2 axis=z both=1
      # dark opening in the cap front where the windshaft passes out
      paint cap color=#0d0d0d box=-2.95,10.1,-0.5,-2.0,11.0,0.5
      # --- panel lines ---
      # horizontal weatherboard seams on the smock
      seam smock plane=0,1,0,4.0 w=0.012
      seam smock plane=0,1,0,4.7 w=0.012
      seam smock plane=0,1,0,5.4 w=0.012
      seam smock plane=0,1,0,6.1 w=0.012
      seam smock plane=0,1,0,6.8 w=0.012
      seam smock plane=0,1,0,7.5 w=0.012
      seam smock plane=0,1,0,8.2 w=0.012
      # brick course seams on the base
      seam base plane=0,1,0,0.8 w=0.018
      seam base plane=0,1,0,1.6 w=0.018
      seam base plane=0,1,0,2.4 w=0.018
      # door frame seam
      seam base box=-3.98,0,-0.95,-3.15,2.3,0.95 w=0.015
      # cap hoop seams following the onion
      seam cap plane=0,1,0,9.7 w=0.012
      seam cap plane=0,1,0,10.5 w=0.012
      seam cap plane=0,1,0,11.3 w=0.012
