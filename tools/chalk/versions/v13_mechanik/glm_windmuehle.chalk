      box scurb4 size=0.05,0.06,1.0 at=-1.02,4.45,0 color=#b08d5f mat=wood
      box shatchdoor size=0.88,0.04,0.88 at=-0.35,4.44,1.15 rot=0,0.12,0.04 color=#b08d5f mat=wood
      cyl shandle r=0.05 h=0.02 hole=0.032 axis=y at=-0.1,4.465,1.35 color=#4a4a4c mat=darkmetal
      box sdust size=0.95,0.008,0.05 at=-1.5,4.484,0.52 color=#e9e1cc mat=matte
      # ================= Treppe, Lauf 1: Boden -> Bindenboden =================
      repeat 10 step=0,0.23,0.26 at=2.35,0.115,-1.5
        box tread size=0.8,0.05,0.30 at=0,0,0 color=#a8865a mat=wood
        box riser size=0.8,0.19,0.03 at=0,-0.12,-0.135 color=#8f6f4a mat=wood
        box nose size=0.8,0.035,0.06 at=0,0.028,0.155 color=#c2a273 mat=wood
      tube str1a pts=2.73,0.1,-1.6,2.73,2.3,0.95 r=0.055 color=#7a5c3a mat=wood
      tube str1b pts=1.97,0.1,-1.6,1.97,2.3,0.95 r=0.055 color=#7a5c3a mat=wood
      tube rail1 pts=1.97,0.95,-1.5,1.97,3.2,0.95 r=0.035 color=#8a6a45 mat=wood
      repeat 6 step=0,0.23,0.26 at=1.97,0.55,-1.38
        cyl bal1 r=0.022 h=0.8 axis=y at=0,0,0 color=#8a6a45 mat=wood
      box landing size=0.5,0.06,0.45 at=2.25,2.33,1.15 color=#a8865a mat=wood shell=1
      cyl lpost1 r=0.05 h=2.3 axis=y at=2.42,1.15,1.32 color=#7a5c3a mat=wood
      cyl lpost2 r=0.05 h=2.3 axis=y at=2.08,1.15,1.32 color=#7a5c3a mat=wood
      # ================= Treppe, Lauf 2: Bindenboden -> Steinboden =================
      repeat 9 step=0,0.2333,-0.25 at=2.45,2.42,1.05
        box tread2 size=0.8,0.05,0.30 at=0,0,0 color=#a8865a mat=wood
        box riser2 size=0.8,0.19,0.03 at=0,-0.12,0.135 color=#8f6f4a mat=wood
        box nose2 size=0.8,0.035,0.06 at=0,0.028,-0.155 color=#c2a273 mat=wood
      tube str2a pts=2.83,2.35,1.15,2.83,4.35,-1.05 r=0.055 color=#7a5c3a mat=wood
      tube str2b pts=2.07,2.35,1.15,2.07,4.35,-1.05 r=0.055 color=#7a5c3a mat=wood
      tube rail2 pts=2.07,3.25,1.05,2.07,4.35,-0.85 r=0.035 color=#8a6a45 mat=wood
      repeat 5 step=0,0.2333,-0.25 at=2.07,2.75,0.95
        cyl bal2 r=0.022 h=0.95 axis=y at=0,0,0 color=#8a6a45 mat=wood
      # ================= Jutesaecke, eine offen mit Getreide =================
      lathe sack1 pts=0,0.10 0.06,0.19 0.14,0.24 0.22,0.22 0.30,0.13 0.34,0.05 axis=y smooth=1 at=1.55,0.05,-0.55 color=#b39a6b mat=fabric
      cyl tie1 r=0.05 h=0.035 hole=0.03 axis=y at=1.55,0.39,-0.55 color=#7d6845 mat=fabric
      lathe sack2 pts=0,0.10 0.06,0.19 0.14,0.24 0.22,0.22 0.30,0.13 0.34,0.05 axis=y smooth=1 at=1.2,0.05,-1.05 rot=0,0.4,0 color=#ac9264 mat=fabric
      cyl tie2 r=0.05 h=0.035 hole=0.03 axis=y at=1.2,0.39,-1.05 color=#7d6845 mat=fabric
      lathe sack3 pts=0,0.10 0.06,0.19 0.14,0.24 0.22,0.22 0.30,0.13 0.34,0.05 axis=y smooth=1 at=1.35,0.26,-1.5 rot=0,0,1.35 color=#b39a6b mat=fabric
      cone spill r=0.16 h=0.12 axis=y at=0.95,0.08,-1.5 color=#d9b56a mat=matte
      # ================= Mehlschaufel und Sieb an der Binde =================
      tube shhandle pts=1.05,0.06,0.4,0.85,1.3,0.18 r=0.025 color=#a8865a mat=wood
      box shblade size=0.2,0.28,0.04 at=1.02,0.17,0.37 rot=0.3,0,0.15 color=#b08d5f mat=wood
      cyl sieve r=0.26 h=0.05 hole=0.22 axis=y at=0.55,0.32,0.35 rot=1.0,0,0.15 color=#9a7b52 mat=wood
      cyl smesh r=0.22 h=0.012 axis=y at=0.55,0.33,0.36 rot=1.0,0,0.15 color=#cfc4ae mat=matte
      # ================= Steinkranten-Werkzeug auf dem Steinboden =================
      tube bill pts=0.5,4.45,0.4,1.3,4.45,0.75 r=0.03 color=#8a6a45 mat=wood
      box billtip size=0.16,0.04,0.07 at=1.38,4.45,0.79 rot=0,0.5,0 color=#b8b8ba mat=brushed
      tube hamhandle pts=-0.3,4.45,0.6,0.25,4.45,0.85 r=0.028 color=#8a6a45 mat=wood
      box hamhead size=0.08,0.07,0.22 at=0.32,4.46,0.88 color=#4a4a4c mat=darkmetal
  mech
    # Fluegelkreuz: Hauptbewegung, Master-Rotor, Drehachse x durch die Nabe
    rotor sails axis=x at=-2.6,10.55,0
    # Windwelle mit Bremsscheibe dreht starr mit den Fluegeln; Lager, Stuetzen und Bremsteile bleiben fest
    rotor windshaft_brake_wheel axis=x at=-1.9,10.55,0 of=sails ratio=1 skip=pillow,pillowcap,grease1,grease2,oiler1,sidebeamL,sidebeamR,kneeL,kneeR,tailpost,tailcross,gudgeon,breastbeam,pbolt1,pbolt2
    # Bremsscheibe (r=1.15) kaemmt ins Bunkerrad (r=0.95): Kegelradpaar, 90 Grad umgelenkt
    rotor upright_shaft_gears axis=y of=windshaft_brake_wheel ratio=-1.21 skip=capbeam,capplate,capcone,pivotsphere,oilcup,footbeam,stepplate,stepcup,oilbox,rope,cleat
    # Steinrad (stone nut, r=0.30) auf der Quantwelle, getrieben vom grossen Zahnrad (r=1.35); Lager, Bruecke und Stellteile bleiben fest
    rotor stonenut1 axis=z at=-1.5,5.20,1.55 in=millstone_drive claim=0.4 of=upright_shaft_gears ratio=4.5 skip=bridge,crane,brgspindle,brgquant,merrimet1,merrimet2,nut1,nut2,tenterscrew,handwheel,oiler2,nutpost
    # Laeuferstein dreht ueber dem festen Bodenstein
    rotor runner1 axis=z at=-1.5,4.80,2.05 in=millstone_drive claim=0.8 of=stonenut1 ratio=1 skip=stonenut,tyre1,tyre2,nutseat,nutstrap,nutset,quant,quantpinion,nutpost,bridge,crane,brgspindle,brgquant,merrimet1,merrimet2,nut1,nut2,tenterscrew,handwheel,oiler2,chip1,chip2,chip3,bedstone,bedfurrow1,bedfurrow2,bedeye,bedbeamA,bedbeamB,strapA1,strapA2,strapB1,wedge1,wedge2,wedge3,vat,spout,flourpile,flour
    # Riemenscheibe am Regler-Stumpf; nur Scheibe und Stumpf drehen, Lager und statischer Riemen bleiben fest
    rotor qpulley1 axis=x at=-0.74,4.84,2.34 in=governor_tenter claim=0.1 of=stonenut1 ratio=1 skip=belt2,qbearing,qpost,qfoot
    # Fliehkraftregler (r=0.065) dreht schneller als die Scheibe (r=0.1)
    rotor gov1 axis=y at=-0.19,4.97,1.94 in=governor_tenter claim=0.32 of=qpulley1 ratio=1.5 skip=ped,bolt,govPad,collarlink,spin1,govlvr,rshaft,fpost,fbase,slever,spin4,bridgelink,stain1,belt1,cshaft,cpulley,pinion
    # echter Riemen von der Scheibe zum Regler, ersetzt die statischen Riemen
    chain beltgov of=qpulley1 ra=0.1 a=-0.74,4.84,2.34 b=-0.19,4.97,1.94 rb=0.065 axis=y pitch=0.03 belt=1
    # Schuettelrinne ruehrt das Korn in den Mahlgang
    sway shoe of=stonenut1 dir=0,1,0 by=0.02 phase=0
  anim
    step "Hollaendische Windmuehle im Schnitt: Fluegel, Koenigswelle und Mahlgang" 5
      run turns=2
      hide belt1
      hide belt2
      camera view=38,9 zoom=0.85 on=whole
    step "Das Fluegelkreuz dreht Windwelle und Bremsscheibe" 4
      run turns=2
      camera view=40,10.5 zoom=1.5 on=sails
    step "Die Bremsscheibe greift ins Bunkerrad und treibt die Koenigswelle an" 4
      run turns=2
      camera view=40,8.5 zoom=1.9 on=upright_shaft_gears
    step "Das grosse Zahnrad treibt den Steintrieb: der Laeuferstein mahlt auf dem Bodenstein" 4
      run turns=2
      camera view=40,5 zoom=2.1 on=millstone_drive
    step "Fliehkraftregler und Schuettelrinne regeln den Getreidenachlauf" 4
      run turns=2
      camera view=40,5.5 zoom=2.2 on=governor_tenter
    step "Der ganze Mahlprozess im Ueberblick" 4
      run turns=2
      camera view=32,10 zoom=0.9 on=whole
