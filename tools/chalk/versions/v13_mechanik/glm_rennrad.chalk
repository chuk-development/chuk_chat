      screw clampScrew r=0.0035 h=0.005 at=0.385,0.347,-0.005 mat=brushed color=#b8b8bc
      # --- Zugausgaenge am Sitzrohr (unter Sattelklemmbereich und mittig) ---
      box seatStopHi size=0.018,0.022,0.014 at=-0.155,0.848,-0.026 mat=plastic color=#101012
      box seatStopLo size=0.016,0.026,0.012 at=-0.133,0.790,-0.037 mat=plastic color=#101012
      # --- Zugführer am Tretlager (Umlenkung auf beide Kettenstreben-Seiten) ---
      box bbGuideL size=0.024,0.010,0.014 at=-0.005,0.310,-0.030 mat=plastic color=#101012
      box bbGuideR size=0.024,0.010,0.020 at=0.02,0.326,0.004 mat=plastic color=#101012
      # --- Kabelbinder ueber beide Hülssen auf dem Oberrohr ---
      repeat 3 step=0.12,-0.032,0 at=-0.50,0.937,0
        box tie size=0.006,0.018,0.054 color=#0d0d0f mat=plastic
      box tieEnd size=0.006,0.016,0.05 at=-0.19,0.862,0 color=#0d0d0f mat=plastic
      # --- Kabelbinder auf der Sitzstrebe (Bremszug) ---
      repeat 2 step=0.08,-0.060,0 at=0.12,0.564,0
        box stayTie size=0.006,0.014,0.016 color=#0d0d0f mat=plastic
      # --- Kabelbinder auf der Kettenstrebe ueber beide Züge ---
      repeat 2 step=0.09,0.009,0 at=0.14,0.325,0
        box csTie size=0.006,0.016,0.070 color=#0d0d0f mat=plastic
      # --- Drei Kabelhalter mit C-Clips am Unterrohr ---
      repeat 3 step=0.134,-0.106,0 at=-0.428,0.656,0
        box cclip size=0.008,0.016,0.054 rot=0,0,37 color=#0d0d0f mat=plastic
