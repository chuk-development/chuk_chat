          # Gabelkopf des Arms am Gehäuse
          mirror x
              plate fork size=0.006,0.03,0.018 at=0.014,-0.095,-0.222 rot=0,0,0 color=#1c1e20 mat=brushed
  mech
    rotor main_rotor at=-2.45,3.45,0 axis=y
    rotor rotor of=main_rotor at=5.47,2.70,0 axis=x ratio=-5.5
  anim
    step "Airbus H145 – startklar auf dem Landeplatz, Rotoren still" 4
      camera view=30,12 zoom=1 on=whole
      hide blur1
      hide blur2
      hide blur
      hide dust
    step "Start: der fuenfblaettrige Hauptrotor nimmt Drehzahl auf" 4
      camera view=50,10 zoom=1.7 on=main_rotor
      run turns=2
    step "Fenestron im Heckausleger laeuft gegensinnig mit" 4
      camera view=-40,8 zoom=2.2 on=fenestron
      run turns=2
      show blur1
      show blur2
      show blur
    step "Leichtewerden: der H145 hebt senkrecht ab, die Kufen verlassen den Boden" 5
      camera view=35,10 zoom=1.3 on=whole
      run turns=2
      move whole by=0,2.6,0
      show dust
      hide pool
      hide beam
    step "Schwebeflug: frei ueber dem Platz bei Volldrehzahl" 4
      camera view=25,14 zoom=1 on=whole
      run turns=2
      hide dust
