      gear clamp1 teeth=16 r=0.13 h=0.035 axis=x at=-0.95,1.0,-0.97 color=#9aa0a6 mat=brushed
      gear clamp2 teeth=16 r=0.13 h=0.035 axis=x at=0.55,0.99,-0.976 color=#9aa0a6 mat=brushed
      # ---- Kabelbinder-Führungsnasen am Block ----
      repeat 4 step=0.78,0,0 at=-1.25,0.88,-0.85
        plate tab pts=0,0 0.055,0 0.055,0.13 0,0.13 h=0.014 color=#141416 mat=rubber
        cyl tyering hole=0.016 r=0.03 h=0.014 axis=z at=0.0275,0.105,0 color=#141416 mat=rubber
      # ---- Klopfsensoren mittig an der -z-Blockwand ----
      repeat 2 step=1.2,0,0 at=-0.6,0.6,-0.85
        cyl boss r=0.095 h=0.025 axis=z at=0,0,-0.012 color=#7a8087 mat=cast
        group ks at=0,0,-0.13
          lathe ksbody pts=0,0.1 0.03,0.1 0.06,0.075 0.1,0.075 0.13,0.05 axis=z smooth=1 color=#3a3e43 mat=cast
          cyl ksscrew r=0.024 h=0.05 axis=z at=0,0,-0.025 color=#d8dde2 mat=steel
          cyl kshex r=0.042 h=0.03 axis=z seg=6 at=0,0,-0.065 color=#b8bdc2 mat=steel
        tube ksbranch pts=0,0.42,-0.11 0,0.28,-0.1 0,0.12,-0.095 r=0.04 color=#17171a mat=rubber
      # ---- Kurbelwellensensor vorn am Blockende ----
      group crank_sensor at=-1.5,0.45,-0.86
        plate bracket pts=-0.07,-0.05 0.07,-0.05 0.07,0.13 -0.07,0.13 h=0.018 color=#5d6b78 mat=cast
        cyl bolt1 r=0.02 h=0.02 axis=z seg=6 at=-0.05,0.1,0.012 color=#b8bdc2 mat=steel
        cyl bolt2 r=0.02 h=0.02 axis=z seg=6 at=0.05,0.1,0.012 color=#b8bdc2 mat=steel
        box csbody size=0.13,0.2,0.08 at=0,0.03,-0.05 color=#23262a mat=plastic
        box csconn size=0.08,0.1,0.06 at=0,0.17,-0.045 color=#1b1b1e mat=plastic
        box latch size=0.018,0.05,0.065 at=0,0.17,-0.08 color=#1b1b1e mat=plastic
        repeat 3 step=0.022,0,0 at=-0.022,0.17,-0.078
          cyl pin r=0.005 h=0.022 axis=z color=#c9a227 mat=gold
        tube csbranch pts=0,0.6,-0.08 0.02,0.44,-0.085 0,0.32,-0.095 r=0.04 color=#17171a mat=rubber
      # ---- Abzweig-Stecker mit Rastnase, hängend am Strang ----
      repeat 2 step=1.1,0,0 at=-0.15,0,0
        tube stub pts=0,1.0,-0.965 0,0.9,-0.955 0,0.84,-0.95 r=0.035 color=#17171a mat=rubber
        box conn size=0.09,0.12,0.06 at=0,0.78,-0.95 color=#202024 mat=plastic
        box latchnose size=0.02,0.05,0.065 at=0,0.78,-0.985 color=#202024 mat=plastic
        box key size=0.03,0.02,0.062 at=0.038,0.74,-0.95 color=#101012 mat=plastic
      # ---- Abzweig nach oben zu den Zündspulen ----
      tube coilbranch pts=0.35,1.0,-0.965 0.35,1.25,-0.93 0.35,1.48,-0.89 r=0.04 color=#17171a mat=rubber
      box coilconn size=0.1,0.12,0.07 at=0.35,1.55,-0.875 rot=0,25,0 color=#202024 mat=plastic
      box coillatch size=0.02,0.05,0.075 at=0.35,1.55,-0.915 rot=0,25,0 color=#101012 mat=plastic
      # ---- Erdungspunkt mit Ringschnabel und Schraube ----
      group ground at=1.3,0.72,-0.85
        cyl stud r=0.024 h=0.05 axis=z at=0,0,-0.015 color=#d8dde2 mat=steel
        cyl ghex r=0.04 h=0.026 axis=z seg=6 at=0,0,-0.045 color=#c2c7cc mat=steel
        cyl ringterm hole=0.028 r=0.055 h=0.012 axis=z at=0,0,-0.062 color=#b0793a mat=copper
        tube groundcable pts=0,0.28,-0.115 0,0.14,-0.09 0,0.04,-0.065 r=0.036 color=#17171a mat=rubber
      # ---- geschnittene Adern enden sichtbar an der Schnittfläche ----
      tube wire1 pts=1.4,0.97,-0.96 1.52,0.97,-0.95 1.585,0.97,-0.945 r=0.016 color=#c62828 mat=plastic
      tube wire2 pts=1.4,1.01,-0.96 1.52,1.01,-0.95 1.585,1.01,-0.945 r=0.016 color=#f9a825 mat=plastic
      tube wire3 pts=1.4,1.05,-0.96 1.52,1.05,-0.95 1.585,1.05,-0.945 r=0.016 color=#1e88e5 mat=plastic
      tube wire4 pts=1.4,1.09,-0.96 1.52,1.09,-0.95 1.585,1.09,-0.945 r=0.016 color=#43a047 mat=plastic
      repeat 4 step=0,0.04,0 at=1.6,0.97,-0.945
        cyl core r=0.007 h=0.03 axis=x color=#c98a3d mat=copper
      # ---- Wartungs-Anhängeetikett ----
      tube tagloop pts=0.15,0.99,-0.985 0.15,0.95,-0.99 r=0.012 color=#17171a mat=rubber
      plate tag pts=0,0 0.06,0 0.06,0.09 0,0.09 h=0.006 at=0.15,0.9,-0.995 rot=0,0,15 color=#f9a825 mat=plastic
  template pis
    # One piston. The wrist pin is at the origin. The crown points to +y. Local x is the crank axis.
    lathe pisb pts=-0.3,-0.3 -0.34,-0.26 -0.34,0.3 -0.3,0.34 0.3,0.34 0.34,0.3 0.34,-0.26 0.3,-0.3 axis=y color=#c7cbd1 mat=brushed
    cyl ring1 r=0.352 h=0.025 axis=y at=0,0.26,0 color=#2b2e33 mat=metal
    cyl ring2 r=0.352 h=0.025 axis=y at=0,0.18,0 color=#2b2e33 mat=metal
    cyl oilring r=0.352 h=0.03 axis=y at=0,0.06,0 color=#2b2e33 mat=metal
    cyl wristpin r=0.1 h=0.72 axis=x color=#e2e4e8 mat=chrome
  template con
    # One con rod. The big end is at the origin, the small end at 0,L,0 where L is the rod length.
    cyl big r=0.26 hole=0.17 h=0.2 axis=x color=#969aa1 mat=cast
    cyl bigrace r=0.185 h=0.21 axis=x color=#c9a227 mat=metal
    cyl boltA r=0.045 h=0.36 axis=y at=0.18,0,0 color=#3a3f45 mat=metal
    cyl boltB r=0.045 h=0.36 axis=y at=-0.18,0,0 color=#3a3f45 mat=metal
    cyl small r=0.15 hole=0.1 h=0.2 axis=x at=0,1.55,0 color=#969aa1 mat=cast
    cyl smallrace r=0.115 h=0.21 axis=x at=0,1.55,0 color=#c9a227 mat=metal
    tube beam pts=0,0.2,0 0,1.4,0 r=0.09 color=#8d9198 mat=cast
    tube ribA pts=0.1,0.28,0 0.1,1.34,0 r=0.035 color=#7c8087 mat=cast
    tube ribB pts=-0.1,0.28,0 -0.1,1.34,0 r=0.035 color=#7c8087 mat=cast
  mech
    rotor damper at=-2.40,0.20,0 axis=x of=crank ratio=1
    rotor wppulley at=-2.41,0.95,0 axis=x of=crank ratio=2.1
    rotor fanblades at=-2.25,1.01,-0.15 axis=x of=crank ratio=2.7
    rotor tenpulley at=-2.47,0.80,0.42 axis=x of=crank ratio=3.2
    rotor campL at=-1.92,1.30,-0.35 axis=x of=crank ratio=0.5
    rotor campR at=-1.92,1.30,0.35 axis=x of=crank ratio=0.5
    rotor cvNcam at=0,1.75,-0.72 axis=x of=crank ratio=0.5
    chain beltA of=crank belt=1 axis=x a=-2.36,0.20,0 ra=0.19 b=-2.36,1.05,-0.18 rb=0.07 pitch=0.03
    chain beltB of=crank belt=1 axis=x a=-2.36,0.20,0 ra=0.19 b=-2.36,1.05,0.28 rb=0.09 pitch=0.03
    chain timL of=crank axis=x a=-1.92,0.20,0 ra=0.10 b=-1.92,1.30,-0.38 rb=0.20 pitch=0.03
    chain timR of=crank axis=x a=-1.92,0.20,0 ra=0.10 b=-1.92,1.30,0.38 rb=0.20 pitch=0.03
    crankshaft crank at=0,0,0 axis=x r=0.43 throws=-1.8:0,-0.6:90,0.6:270,1.8:180
    cylinder a1 crank=crank x=-2.01 throw=0 angle=45 rod=1.55 piston=pis conrod=con flame=0.4 crown=0.34
    cylinder b1 crank=crank x=-1.59 throw=0 angle=-45 rod=1.55 piston=pis conrod=con flame=0.4 crown=0.34
    cylinder c1 crank=crank x=-0.81 throw=90 angle=45 rod=1.55 piston=pis conrod=con flame=0.4 crown=0.34
    cylinder d1 crank=crank x=-0.39 throw=90 angle=-45 rod=1.55 piston=pis conrod=con flame=0.4 crown=0.34
    cylinder e1 crank=crank x=0.39 throw=270 angle=45 rod=1.55 piston=pis conrod=con flame=0.4 crown=0.34
    cylinder f1 crank=crank x=0.81 throw=270 angle=-45 rod=1.55 piston=pis conrod=con flame=0.4 crown=0.34
    cylinder g1 crank=crank x=1.59 throw=180 angle=45 rod=1.55 piston=pis conrod=con flame=0.4 crown=0.34
    cylinder h1 crank=crank x=2.01 throw=180 angle=-45 rod=1.55 piston=pis conrod=con flame=0.4 crown=0.34
    block eng crank=crank bore=0.36 color=#5d6b78 cover=#b5461f
  anim
    step "V8 im Schnitt: Kurbeltrieb, Kolben und Nebenaggregate" 4
      run turns=2
      camera view=28,12 zoom=1 on=whole
      hide chainA
      hide chainB
      hide linkR
      hide linkL
      hide linkT
      hide belt
    step "Kurbelwelle: vier Hubzapfen, versetzt um 90 Grad" 4
      run turns=2
      camera view=18,8 zoom=1.5 on=crank
    step "Pleuel und Kolben: aus Drehung wird Hubbewegung" 4
      run turns=2
      camera view=35,10 zoom=1.4 on=pisb
    step "Keilrippenriemen treibt Lichtmaschine und Wasserpumpe" 4
      run turns=2
      camera view=40,10 zoom=1.7 on=front_accessory_drive
    step "Steuerkette: Nockenwellen drehen mit halber Kurbelzahl" 4
      run turns=2
      camera view=40,14 zoom=1.8 on=timing_drive
    step "Gesamtlauf des geschnittenen V8" 4
      run turns=2
      camera view=28,12 zoom=1 on=whole
