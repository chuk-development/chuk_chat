canvas paper
title "Wie funktioniert ein Toaster?"
row gap=48
  model toast 700 430 view=-28,18
    loft body sections=-1.45,3.3,1.7 -1.1,3.4,1.8 1.1,3.4,1.8 1.45,3.15,1.65 square=1 axis=z at=0,0.95,0 color=alu label="Gehäuse"
    box top size=3.3,0.1,2.85 on=body+y sink=0.3 color=steel
    box slot1 size=0.3,0.1,1.5 at=-1.05,1.88,0 color=black
    box slot2 size=0.3,0.1,1.5 at=-0.35,1.88,0 color=black
    box slot3 size=0.3,0.1,1.5 at=0.35,1.88,0 color=black
    box slot4 size=0.3,0.1,1.5 at=1.05,1.88,0 color=black
    group breads label="Brot"
      box b1 size=0.26,1.1,1.3 at=-1.05,2.2,0 round=0.03 color=#e8b566
      box b2 size=0.26,1.1,1.3 at=-0.35,2.2,0 round=0.03 color=#d99a4e
      box b3 size=0.26,1.1,1.3 at=0.35,2.2,0 round=0.03 color=#e8b566
      box b4 size=0.26,1.1,1.3 at=1.05,2.2,0 round=0.03 color=#d99a4e
    group leverL at=-0.7,1.05,1.5 label="Hebel"
      box panel size=1.0,1.15,0.12 round=0.12 color=dark
      box grip size=0.55,0.16,0.2 at=0,0.32,0.12 color=steel
    group leverR at=0.7,1.05,1.5
      box panel size=1.0,1.15,0.12 round=0.12 color=dark
      box grip size=0.55,0.16,0.2 at=0,0.32,0.12 color=steel
    cyl knobL r=0.3 h=0.18 axis=z at=-0.7,0.5,1.52 color=steel label="Röstgrad"
    box ptrL size=0.05,0.16,0.06 at=-0.7,0.72,1.62 color=dark
    cyl knobR r=0.3 h=0.18 axis=z at=0.7,0.5,1.52 color=steel
    box ptrR size=0.05,0.16,0.06 at=0.7,0.72,1.62 color=dark
    box btn1 size=0.5,0.12,0.08 at=-1.35,0.85,1.5 color=steel
    box btn2 size=0.5,0.12,0.08 at=-1.35,0.65,1.5 color=steel
    box btn3 size=0.5,0.12,0.08 at=-1.35,0.45,1.5 color=steel
    box btn4 size=0.5,0.12,0.08 at=1.35,0.85,1.5 color=steel
    box btn5 size=0.5,0.12,0.08 at=1.35,0.65,1.5 color=steel
    box btn6 size=0.5,0.12,0.08 at=1.35,0.45,1.5 color=steel
    mirror z
      box foot size=0.5,0.15,0.3 at=-1.3,0.08,1.1 color=black
      box foot2 size=0.5,0.15,0.3 at=1.3,0.08,1.1 color=black
    anim
      step "Hebel drücken: Brot und Schlitten sinken" 1.8
        camera view=-30,20 zoom=1.4 on=leverL
        move leverL by=0,-0.3,0
        move leverR by=0,-0.3,0
        move breads by=0,-0.5,0
      step "Heizelemente glühen – das Brot bräunt" 2.2
        camera view=0,28 zoom=1.25
        pulse breads
      step "Der Toaster springt aus: Brot poppt hoch" 1.8
        move leverL by=0,0.3,0
        move leverR by=0,0.3,0
        move breads by=0,0.8,0
      step "Fertig" 1.2
        camera view=-28,18 zoom=1
  col gap=14
    note "Der Hebel klemmt das Brot ein und senkt den Schlitten ab." color=yellow
    note "Nichrom-Drähte glühen auf ca. 800 °C und bräunen das Brot von beiden Seiten." color=orange
    note "Ein Bi-Metall-Streifen krümmt sich in der Hitze – bei der Zieltemperatur löst er die Feder aus: das Brot springt hoch." color=green
h2 "Innenleben: so bräunt der Toaster"
row gap=48
  model inner 560 360 view=24,16 cut=z>0
    box case size=2.4,1.9,1.4 shell=1 round=0.08 color=alu label="Gehäuse"
    box bread size=0.5,1.5,1.0 at=0,0.95,0 color=#e0a860 label="Brot"
    mirror z
      cyl rod r=0.05 h=1.6 axis=y at=-0.45,0.95,0.35 color=orange label="Heizdraht"
      cyl rod2 r=0.05 h=1.6 axis=y at=0.45,0.95,0.35 color=orange
    box tray size=2.2,0.06,1.2 at=0,0.1,0 color=darkmetal label="Krümelschublade"
  col gap=14
    text "Pro Schlittenschacht flanken zwei senkrechte Heizdrähte die Scheibe. Sie strahlen von beiden Seiten gleichmäßig Wärme ein – deshalb wird das Brot außen knusprig und innen warm." w=420
    note "Die Krümelschublade unten fängt die Brösel." color=yellow
