title "Dampfmaschine mit Riemen"
wheel schwungrad r=1.4 at=0,0 blades=6 color=#8a8a8a
piston kolben to=schwungrad dir=0
wheel riemenscheibe r=0.6 to=schwungrad by=axle color=#b5461f
wheel abtrieb r=1.2 to=riemenscheibe by=belt dir=0 dist=4 color=#3f7fb5
block kessel size=3,1.4 at=-3.2,-1.5 color=#5a5a5a
step "Dampf drückt den Kolben an" on=kolben
step "Das Schwungrad speichert die Bewegung" on=schwungrad
step "Ein Riemen überträgt die Drehung" on=riemenscheibe
step "Die grosse Scheibe dreht langsamer, aber kraftvoll" on=abtrieb
step "So treibt die Dampfmaschine eine ganze Fabrik an"
