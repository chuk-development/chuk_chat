      box cavity size=3.2,8.0,11.9 at=12.7,8.2,0 color=#060606 mat=matte
      # 8 gold contact fingers angled down inside the cavity
      repeat 8 step=0,0,1.15 at=13.3,12.0,-4.05
        box finger size=1.7,0.12,0.45 rot=0,0,20 color=#d8b23a mat=gold
      box contact_bar size=1.0,0.14,9.6 at=13.9,11.4,0 color=#c9a53a mat=gold
