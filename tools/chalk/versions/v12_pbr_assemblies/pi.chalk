      cyl led_g r=0.6 h=0.35 axis=x at=10.9,3.0,6.4 color=#39ff6a mat=light
      cyl led_rim_a r=1.0 h=0.5 axis=x at=11.05,3.0,-6.4 color=#1c1c1c mat=plastic
      cyl led_a r=0.6 h=0.35 axis=x at=10.9,3.0,-6.4 color=#ffb43a mat=light
      # --- laser-etched part text on left shield wall ---
