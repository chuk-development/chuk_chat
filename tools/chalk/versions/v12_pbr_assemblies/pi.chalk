          repeat 2 step=3.8,0,0 at=-1.9,0,0
            box foot size=1.1,0.2,1.3 at=0,0.1,0 color=#8a8e92 mat=brushed
          box silk1 size=6.2,0.04,0.12 at=0,0.02,2.0 color=#e8e8e8 mat=matte
          box silk2 size=6.2,0.04,0.12 at=0,0.02,-2.0 color=#e8e8e8 mat=matte
          box silk3 size=0.12,0.04,4.1 at=3.05,0.02,0 color=#e8e8e8 mat=matte
          box silk4 size=0.12,0.04,4.1 at=-3.05,0.02,0 color=#e8e8e8 mat=matte
        # ---- black power push-button with white actuator dot
        group pwrbtn at=32,1.6,-21
          cyl flange r=2.4 h=1.1 axis=y color=#141414 mat=plastic
          cyl stem r=1.7 h=2.4 axis=y at=0,1.1,0 color=#1a1a1a mat=plastic
          cyl dot r=0.85 h=0.35 axis=y at=0,3.45,0 color=#e8e8e8 mat=plastic
          cyl silk r=3.2 hole=2.8 h=0.05 axis=y at=0,0.02,0 color=#e8e8e8 mat=matte
        # ---- 3-pin fan header, shrouded, gold pins
        group fanhdr at=57,1.6,-15
          box body size=7.6,2.0,4.6 at=0,1.0,0 round=0.08 color=#101010 mat=plastic
          box walla size=7.6,1.5,0.6 at=0,2.7,2.0 color=#101010 mat=plastic
          box wallb size=7.6,1.5,0.6 at=0,2.7,-2.0 color=#101010 mat=plastic
          box key size=1.3,0.6,0.7 at=0,3.05,2.0 color=#050505 mat=plastic
          repeat 3 step=2.54,0,0 at=-2.54,0,0
            box pin size=0.64,2.8,0.64 at=0,1.9,0 color=#d9b545 mat=brushed
          box silk1 size=8.4,0.04,0.12 at=0,0.02,2.7 color=#e8e8e8 mat=matte
          box silk2 size=8.4,0.04,0.12 at=0,0.02,-2.7 color=#e8e8e8 mat=matte
        # ---- two 2-pin shrouded headers (UART / JTAG)
        repeat 2 step=9,0,3 at=70,1.6,-16
          group jhdr
            box body size=6.6,2.0,4.6 at=0,1.0,0 round=0.08 color=#101010 mat=plastic
            box walla size=6.6,1.5,0.6 at=0,2.7,2.0 color=#101010 mat=plastic
            box wallb size=6.6,1.5,0.6 at=0,2.7,-2.0 color=#101010 mat=plastic
            box key size=1.2,0.6,0.7 at=0,3.05,2.0 color=#050505 mat=plastic
            repeat 2 step=2.54,0,0 at=-1.27,0,0
              box pin size=0.64,2.8,0.64 at=0,1.9,0 color=#d9b545 mat=brushed
            box silk1 size=7.4,0.04,0.12 at=0,0.02,2.7 color=#e8e8e8 mat=matte
            box silk2 size=7.4,0.04,0.12 at=0,0.02,-2.7 color=#e8e8e8 mat=matte
        # ---- small SOIC chips with pin rows
        group ic1 at=47,1.6,-17
          box pkg size=4.4,1.5,3.2 at=0,0.85,0 color=#17171c mat=plastic
          box dot size=0.5,0.05,0.5 at=-1.5,1.62,-0.9 color=#3a3a40 mat=matte
          repeat 3 step=1.1,0,0 at=-1.1,0,1.75
            box pin size=0.55,0.3,0.6 at=0,0.35,0 color=#b9bdc1 mat=brushed
          repeat 3 step=1.1,0,0 at=-1.1,0,-1.75
            box pin size=0.55,0.3,0.6 at=0,0.35,0 color=#b9bdc1 mat=brushed
        group ic2 at=85,1.6,-9
          box pkg size=3.2,1.2,2.2 at=0,0.7,0 color=#15151a mat=plastic
          repeat 2 step=1.0,0,0 at=-0.5,0,1.25
            box pin size=0.5,0.28,0.5 at=0,0.3,0 color=#b9bdc1 mat=brushed
          repeat 2 step=1.0,0,0 at=-0.5,0,-1.25
            box pin size=0.5,0.28,0.5 at=0,0.3,0 color=#b9bdc1 mat=brushed
        # ---- SOT-23 transistor row
        repeat 3 step=2.4,0,0 at=40,1.6,12
          group sot
            box body size=1.3,0.9,1.4 at=0,0.5,0 color=#15151a mat=plastic
            repeat 3 step=0,0,0.6 at=0,0,-0.6
              box leg size=0.32,0.25,0.5 at=0,0.12,0 color=#b9bdc1 mat=brushed
        # ---- aluminium electrolytic caps with stripe and vent cross
        group ecap at=22,1.6,-21
          cyl can r=1.7 h=2.6 axis=y at=0,1.3,0 color=#1c2c54 mat=plastic
          cyl top r=1.55 h=0.25 axis=y at=0,2.62,0 color=#b9bdc1 mat=brushed
          box stripe size=0.5,2.3,0.12 at=0,1.3,1.72 color=#e8e8e8 mat=matte
          box crossa size=2.2,0.04,0.16 at=0,2.76,0 color=#8a8e92 mat=matte
          box crossb size=0.16,0.04,2.2 at=0,2.76,0 color=#8a8e92 mat=matte
          box polarm size=0.9,0.04,0.35 at=-2.7,0.02,0 color=#e8e8e8 mat=matte
        group ecap2 at=49.5,1.6,23.5
          cyl can r=1.2 h=2.0 axis=y at=0,1.0,0 color=#20304e mat=plastic
          cyl top r=1.05 h=0.2 axis=y at=0,2.05,0 color=#b9bdc1 mat=brushed
          box stripe size=0.4,1.8,0.1 at=0,1.0,1.2 color=#e8e8e8 mat=matte
        # ---- shielded power inductors near the SoC rails
        group ind1 at=76,1.6,-22
          box core size=4.5,2.2,4 at=0,1.1,0 color=#3a3e44 mat=plastic
          box plate size=4.5,0.15,4 at=0,2.25,0 color=#2a2d31 mat=matte
          box mark size=1.6,0.04,0.14 at=0,2.34,0 color=#9a9ea4 mat=matte
        group ind2 at=84,1.6,-18
          box core size=3.6,1.8,3.2 at=0,0.9,0 color=#3a3e44 mat=plastic
          box plate size=3.6,0.15,3.2 at=0,1.85,0 color=#2a2d31 mat=matte
        # ---- green power LED with white body
        group led at=20,1.6,-10.5
          box body size=1.6,0.7,0.9 at=0,0.35,0 color=#e8e8e8 mat=plastic
          box lens size=1.2,0.25,0.6 at=0,0.8,0 color=#39d353 mat=light
        # ---- 0402/0602 passive clusters, tan caps and black resistors
        repeat 4 step=1.9,0,0 at=56,1.6,19.5
          box cap size=1.0,0.55,0.6 at=0,0.28,0 color=#c9a86b mat=ceramic
        repeat 3 step=1.9,0,0 at=56.9,1.6,21.2
          box res size=1.0,0.5,0.55 at=0,0.25,0 color=#1c1c1c mat=plastic
        repeat 4 step=1.9,0,0 at=44,1.6,20
          box cap size=1.0,0.55,0.6 at=0,0.28,0 color=#c9a86b mat=ceramic
        repeat 3 step=1.9,0,0 at=44.8,1.6,21.4
          box res size=1.0,0.5,0.55 at=0,0.25,0 color=#1c1c1c mat=plastic
        repeat 3 step=1.8,0,0 at=78,1.6,-9.5
          box cap size=1.0,0.55,0.6 at=0,0.28,0 color=#c9a86b mat=ceramic
        repeat 3 step=1.7,0,0 at=52,1.6,10.3
          box res size=0.9,0.5,0.5 at=0,0.25,0 color=#1c1c1c mat=plastic
        repeat 3 step=1.8,0,0 at=35,1.6,-22.5
          box cap size=1.0,0.55,0.6 at=0,0.28,0 color=#c9a86b mat=ceramic
        repeat 4 step=1.9,0,0 at=18,1.6,17
          box cap size=1.0,0.55,0.6 at=0,0.28,0 color=#c9a86b mat=ceramic
        repeat 3 step=1.9,0,0 at=18.8,1.6,18.4
          box res size=1.0,0.5,0.55 at=0,0.25,0 color=#1c1c1c mat=plastic
        repeat 3 step=1.8,0,0 at=20,1.6,-24
          box cap size=1.0,0.55,0.6 at=0,0.28,0 color=#c9a86b mat=ceramic
        repeat 4 step=1.9,0,0 at=87,1.6,20
          box cap size=1.0,0.55,0.6 at=0,0.28,0 color=#c9a86b mat=ceramic
        repeat 2 step=1.8,0,0 at=87.9,1.6,21.2
          box res size=1.0,0.5,0.55 at=0,0.25,0 color=#1c1c1c mat=plastic
        repeat 3 step=1.8,0,0 at=64,1.6,-20
          box cap size=1.0,0.55,0.6 at=0,0.28,0 color=#c9a86b mat=ceramic
        repeat 4 step=1.9,0,0 at=79,1.6,9
          box cap size=1.0,0.55,0.6 at=0,0.28,0 color=#bfa468 mat=ceramic
        # ---- tiny white silk polarity dots near a cap row
        repeat 4 step=1.9,0,0 at=40,1.62,18.5
          box dot size=0.3,0.04,0.3 at=0,0.02,0.6 color=#e8e8e8 mat=matte
        # ---- gold test-pad cluster
        ring 6 r=2.6 axis=y at=88,1.6,12
          cyl pad r=0.45 h=0.06 color=#d9b545 mat=brushed
        # ---- silkscreen raspberry fruit mark beside the wordmark
        sphere logo r=0.7 at=37.5,1.72,23.5 scale=1,0.5,1 color=#e8e8e8 mat=matte
        box leafa size=0.35,0.04,0.15 at=38,1.74,23.9 rot=0,25,0 color=#e8e8e8 mat=matte
        box leafb size=0.35,0.04,0.15 at=37,1.74,23.9 rot=0,-25,0 color=#e8e8e8 mat=matte
        # ---- printed silkscreen legends, realistic scale
        decal hull "Raspberry Pi 5" at=44,23.5 axis=y h=0.9 color=#e8e8e8 bold=1
        decal hull "DISP" at=67.5,26.5 axis=y h=0.5 color=#e8e8e8
        decal hull "FAN" at=57,-19.5 axis=y h=0.5 color=#e8e8e8
        decal hull "UART" at=70,-20.5 axis=y h=0.5 color=#e8e8e8
        decal hull "JTAG" at=79,-17.5 axis=y h=0.5 color=#e8e8e8
        decal hull "RUN" at=32,-25.8 axis=y h=0.5 color=#e8e8e8
        decal hull "PoE" at=31,26.8 axis=y h=0.45 color=#e8e8e8
        decal hull "PSU" at=14,-20.5 axis=y h=0.45 color=#e8e8e8
        decal hull "SD" at=19,25.5 axis=y h=0.45 color=#e8e8e8
        decal hull "X1" at=64,-15.5 axis=y h=0.4 color=#e8e8e8
  anim
    step "So verbindest du die Kamera mit dem Raspberry Pi 5" 2.5
      camera view=-35,25 zoom=1 on=whole
      pulse board_passives
    step "Zuerst den Verriegelungsbügel des Kameraanschlusses öffnen" 2.2
      camera view=-30,25 zoom=4 on=cam_port_pi
      move latch by=0,1.6,0
    step "Das Kameramodul mit IMX708-Sensor und Objektiv" 2.5
      camera view=-40,20 zoom=2 on=camera_module
      move camera_module from=0,4,0
      spin camera_module turns=1 axis=y
    step "Das Flachbandkabel einstecken und den Bügel zudrücken" 2.6
      camera view=-30,20 zoom=4 on=cam_port_pi
      move ribbon from=0,2,0
      move latch by=0,-1.6,0
    step "Fertig – die Kamera ist angeschlossen" 2.5
      camera view=-35,20 zoom=1.4 on=whole
      pulse camera_module
