        repeat 3 step=3.2,0,0 at=14.5,6.2,-8.02
          cyl wdimple r=0.5 h=0.14 axis=z color=#94989c mat=brushed
      # --- front bezel at board edge x=11, RJ45 opening 12 x 8 mm ---
      box bezel_top size=0.6,1.3,16 at=11.3,12.85,0 color=#b9bdc1 mat=brushed
      box bezel_bot size=0.6,2.6,16 at=11.3,2.9,0 color=#b9bdc1 mat=brushed
      mirror z
        box bezel_side size=0.6,9.3,1.0 at=11.3,8.85,7.5 color=#b9bdc1 mat=brushed
      # proud nickel lip framing the opening
      box lip_top size=0.3,0.5,12.8 at=10.95,12.45,0 color=#c0c4c8 mat=brushed
      box lip_bot size=0.3,0.5,12.8 at=10.95,3.95,0 color=#c0c4c8 mat=brushed
      mirror z
        box lip_side size=0.3,8.0,0.5 at=10.95,8.2,6.25 color=#c0c4c8 mat=brushed
