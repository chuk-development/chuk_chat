    group eth_jack at=0,0,0 label="RJ45 Ethernet jack with magnetics"
      # --- stamped nickel shield, two-stage taper, base at PCB top y=1.6 ---
      box shield_lower size=15,7.6,16 at=18.5,5.8,0 color=#b9bdc1 mat=brushed
      box shield_upper size=14.2,3.5,14.6 at=18.7,11.35,0 color=#b4b8bc mat=brushed
      box shield_cap size=13.4,0.4,14.0 at=18.9,13.3,0 color=#bcc0c4 mat=brushed round=0.08
      # dark shadow gap where shield meets the green board
      box base_gap size=15.12,0.32,16.12 at=18.5,1.84,0 color=#141414 mat=matte
      # stamped horizontal seam at the taper step
      box seam_step size=14.5,0.12,14.9 at=18.7,9.62,0 color=#767a7e mat=brushed
      box seam_cap size=13.6,0.1,14.2 at=18.9,13.08,0 color=#7d8185 mat=brushed
      # vertical stamped corner seams, front and rear
      mirror z
        box cseamF size=0.14,11.4,0.14 at=11.1,7.55,7.93 color=#767a7e mat=brushed
        box cseamR size=0.14,11.4,0.14 at=25.9,7.55,7.93 color=#767a7e mat=brushed
      # vent dimples pressed into the top cap
      repeat 4 step=2.6,0,0 at=14.9,13.52,-4.2
        cyl dimple r=0.4 h=0.16 axis=y color=#6f7377 mat=brushed
      repeat 4 step=2.6,0,0 at=14.9,13.52,0
        cyl dimple r=0.4 h=0.16 axis=y color=#6f7377 mat=brushed
      repeat 4 step=2.6,0,0 at=14.9,13.52,4.2
        cyl dimple r=0.4 h=0.16 axis=y color=#6f7377 mat=brushed
