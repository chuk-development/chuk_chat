  anim
    step "Anflug: Der Weißkopfseeadler steigt herauf" 2.6
      camera yaw=40 pitch=18 zoom=1 on=whole
      move whole from=0,-1.4,0
      swing fluegeldecken deg=18 axis=x pivot=0,0.3,0 cycles=2
      swing armschwingen deg=18 axis=x pivot=0,0.3,0 cycles=2
      swing alula_bogen deg=18 axis=x pivot=0,0.3,0 cycles=2
      swing hand_spreizung deg=18 axis=x pivot=0,0.3,0 cycles=2
      osc whole by=0,-0.12,0 cycles=2 phase=0.5
    step "Der mächtige Flügelschlag" 2.8
      camera yaw=25 pitch=28 zoom=1.5 on=fluegeldecken
      swing fluegeldecken deg=30 axis=x pivot=0,0.3,0 cycles=3
      swing armschwingen deg=30 axis=x pivot=0,0.3,0 cycles=3
      swing alula_bogen deg=30 axis=x pivot=0,0.3,0 cycles=3
      swing hand_spreizung deg=30 axis=x pivot=0,0.3,0 cycles=3
      osc whole by=0,-0.15,0 cycles=3 phase=0.5
    step "Aufmerksam Blick und Schnabel" 2.4
      camera yaw=-35 pitch=15 zoom=2.2 on=kopf_gesicht
      swing kopf_gesicht deg=14 axis=y pivot=-0.4,0.5,0 cycles=2
      swing schnabel_detail deg=14 axis=y pivot=-0.4,0.5,0 cycles=2
      swing fluegeldecken deg=10 axis=x pivot=0,0.3,0 cycles=2
      swing armschwingen deg=10 axis=x pivot=0,0.3,0 cycles=2
      swing hand_spreizung deg=10 axis=x pivot=0,0.3,0 cycles=2
    step "Gesteuert mit Schwanz und Fängen" 2.6
      camera yaw=15 pitch=8 zoom=1.5 on=schwanzdecken
      swing schwanzdecken deg=12 axis=z pivot=0.4,0.35,0 cycles=3
      osc beine_faenge by=0,-0.06,0 cycles=3 phase=0.25
      swing fluegeldecken deg=24 axis=x pivot=0,0.3,0 cycles=3
      swing armschwingen deg=24 axis=x pivot=0,0.3,0 cycles=3
      swing alula_bogen deg=24 axis=x pivot=0,0.3,0 cycles=3
      swing hand_spreizung deg=24 axis=x pivot=0,0.3,0 cycles=3
    step "Kraftvoll im Gleitflug" 2.8
      camera yaw=40 pitch=20 zoom=1 on=whole
      swing fluegeldecken deg=32 axis=x pivot=0,0.3,0 cycles=3
      swing armschwingen deg=32 axis=x pivot=0,0.3,0 cycles=3
      swing alula_bogen deg=32 axis=x pivot=0,0.3,0 cycles=3
      swing hand_spreizung deg=32 axis=x pivot=0,0.3,0 cycles=3
      swing schwanzdecken deg=10 axis=z pivot=0.4,0.35,0 cycles=3
      osc whole by=0,-0.14,0 cycles=3 phase=0.5
