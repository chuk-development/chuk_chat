    group rumpf_mantel label="Mantel- und Schulterfedern sowie Brustbefiederung"
      # --- Strähniger Übergang zum weißen Halskragen ---
      group kragen at=-0.30,0.60,0
        limb kragen_m pts=0,0,0,0.014 0.10,-0.05,0,0.003 color=#efe9da mat=matte
        mirror z
          limb kragen_a pts=0,0.01,0.04,0.012 0.09,-0.05,0.055,0.003 color=#e6dfcd mat=matte
          limb kragen_b pts=0,-0.01,0.09,0.011 0.08,-0.06,0.105,0.003 color=#241509 mat=matte
          limb kragen_c pts=0,-0.03,0.14,0.010 0.07,-0.08,0.155,0.003 color=#d8d0bc mat=matte
      # --- Lange lanzettliche Mantelfedern, gekämmt nach hinten, mit hellen Säumen ---
      repeat 5 step=0.13,-0.02,0 at=-0.26,0.62,0
        limb mantel_m pts=0,0,0,0.018 0.17,-0.03,0,0.004 color=#241509 mat=matte
        limb mantel_kiel pts=0,0.005,0,0.0025 0.14,-0.022,0,0.001 color=#5a3a1c mat=matte
        mirror z
          limb mantel_i pts=0,-0.01,0.07,0.016 0.15,-0.045,0.10,0.004 color=#241509 mat=matte
          limb mantel_m2 pts=0,-0.02,0.14,0.014 0.13,-0.06,0.175,0.005 color=#2b1a0c mat=matte
          limb mantel_saum pts=0,-0.045,0.21,0.012 0.11,-0.09,0.245,0.004 color=#4a2c15 mat=matte
      # --- Schulterfedern (Scapulars), größer, hell gesäumt, leicht aufgestellt ---
      group schulter at=-0.10,0.57,0
        mirror z
          repeat 3 step=0.085,0,0
            limb scap pts=0,0.01,0.15,0.016 0.18,-0.03,0.21,0.004 color=#33200e mat=matte
            limb scap_kiel pts=0.01,0.016,0.155,0.002 0.16,-0.018,0.20,0.001 color=#4a2c15 mat=matte
      # --- Mantelbrücke über die Flügelwurzeln ---
      group fluegelwurzel at=-0.16,0.58,0.20
        mirror z
          repeat 3 step=0.09,0,0
            limb wurzel_f pts=0,0,0,0.014 0.08,-0.05,0.10,0.003 color=#33200e mat=matte
      # --- Brustbefiederung: kurz, dicht, nach hinten-unten gekämmt ---
      repeat 4 step=0.015,-0.04,0 at=-0.305,0.585,0
        limb brust_m pts=0,0,0,0.014 0.09,-0.04,0,0.003 color=#241509 mat=matte
        mirror z
          limb brust_i pts=0.01,0,0.07,0.013 0.10,-0.045,0.09,0.003 color=#241509 mat=matte
          limb brust_a pts=0.03,-0.005,0.14,0.012 0.11,-0.06,0.165,0.003 color=#2b1a0c mat=matte
      # --- Feine helle Sprenkelung auf der Brust ---
      mirror z
        repeat 3 step=0.02,-0.055,0 at=-0.315,0.575,0
          limb sprenkel pts=-0.005,0.012,0.06,0.008 0.05,-0.012,0.072,0.002 color=#4a3520 mat=matte
      # --- Flankenfedern: lang, locker, leicht aufgestellt ---
      group flanken at=-0.02,0.46,0.15
        mirror z
          repeat 3 step=0.085,0,0
            limb flank_a pts=0,0,0,0.015 0.13,-0.09,0.06,0.004 color=#2e1c0c mat=matte
            limb flank_b pts=0.02,0.012,0.05,0.012 0.14,-0.08,0.10,0.003 color=#241509 mat=matte
      # --- Bauchgefieder mittig ---
      repeat 3 step=0.09,0,0 at=0.06,0.35,0
        limb bauch_f pts=0,0,0,0.014 0.10,-0.05,0.02,0.004 color=#1f1208 mat=matte
      # --- Beinwurzel verdeckende Bauchfedern an den Seiten ---
      mirror z
        repeat 3 step=0.09,0,0 at=0.02,0.42,0.16
          limb beindecke pts=0,0,0,0.016 0.13,-0.10,0.05,0.004 color=#241509 mat=matte
      # --- Bürzelfeld: dunkler, glatter, dicht anliegend ---
      group buerzel at=0.32,0.52,0
        sphere buerzel_kappe scale=0.06,0.022,0.11 color=#1a1008 mat=matte
        mirror z
          limb buerzel_a pts=0,-0.01,0.06,0.014 0.06,-0.025,0.085,0.005 color=#1c1108 mat=matte
          limb buerzel_b pts=0,0,0.10,0.011 0.05,-0.02,0.12,0.004 color=#241509 mat=matte
