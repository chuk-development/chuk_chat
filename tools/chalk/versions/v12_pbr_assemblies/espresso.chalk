        repeat 2 step=20,0,0 at=3.5,0,-11.5
          # Körper: flache Bodenkante, leicht bauchig, oben in Sockel versenkt
          lathe foot pts=0,1.45 0.015,1.68 0.07,1.75 0.3,1.76 0.46,1.73 0.55,1.35 axis=y smooth=1 color=#26292c mat=rubber
          # feine Riffelung: vertikale Grate am Umfang
          ring 28 r=1.72 axis=y at=0,0.24,0
            box rib size=0.06,0.3,0.06 color=#202326 mat=rubber
          # obere feine Partungslinie
          cyl seam_top r=1.78 h=0.012 hole=1.7 axis=y at=0,0.42,0 color=#1e2124 mat=rubber
          # untere Partungslinie über der Bodenkante
          cyl seam_bot r=1.78 h=0.012 hole=1.7 axis=y at=0,0.09,0 color=#1e2124 mat=rubber
          # Last-Abflachung: dunkle Kontaktzone am Boden
          cyl contact r=1.6 h=0.02 hole=0.6 axis=y at=0,0.012,0 color=#1b1e20 mat=rubber
          # hauchfeiner Staubrand am Fußumfang
          cyl dust r=1.94 h=0.012 hole=1.76 axis=y at=0,0.008,0 color=#3d4043 mat=matte
          # versenkte Stahl-Unterlegscheibe im Fußzentrum (von unten sichtbar)
          cyl washer r=0.7 h=0.025 hole=0.28 axis=y at=0,0.02,0 color=#6f7478 mat=brushed
  anim
    step "Die Maschine in der Übersicht" 2.4
      camera view=40,18 zoom=1 on=whole
      move whole from=0,-4,0
      spin whole turns=0.4 axis=y

    step "Der Siebträger wird eingelegt und verriegelt" 2.8
      camera view=-35,15 zoom=1.8 on=portafilter
      move portafilter from=-8,0,6
      spin portafilter turns=0.5 axis=y
      pulse group_head_face

    step "Heißer Druck: Espresso läuft in dünnen Strähnen" 3
      camera view=-25,10 zoom=2.2 on=group_head_face
      show drop1
      show drop2
      show drop3
      osc drop1 by=0,-0.6,0 cycles=3
      osc drop2 by=0,-0.6,0 cycles=3 phase=0.3
      osc drop3 by=0,-0.6,0 cycles=3 phase=0.6

    step "Die Dampflanze düst Milch für feinen Schaum" 2.8
      camera view=35,12 zoom=1.9 on=steam_wand
      move steam_wand by=0,-0.8,1.5
      show wisp
      osc wisp by=0,0.8,0 cycles=2

    step "Heißwasser links, Druck prüfen vorne" 2.6
      camera view=20,14 zoom=1.7 on=hot_water_spout
      move hot_water_spout by=0,-0.4,0
      pulse hot_water_spout
      camera view=-30,20 zoom=2 on=pressure_gauge
      move g_needle by=0,0,0.2
      pulse pressure_gauge

    step "Fertig: die Espresso-Maschine im Ganzen" 2.2
      camera view=40,20 zoom=1 on=whole
      spin whole turns=0.3 axis=y
