  anim
    step "Der V8 im Schnitt – Gesamtübersicht" 2.5
      camera view=40,20 zoom=1 on=whole
      spin kurbelwelle turns=2 axis=x
      spin nockenwelle turns=2 axis=x

    step "Blick in die rechte Zylinderbank" 2.5
      camera view=-35,15 zoom=2.2 on=kolben_rechts
      hide ansauggung
      hide zuendung
      osc kolben_rechts by=0,-0.14,0 cycles=4 phase=0
      spin kurbelwelle turns=6 axis=x

    step "Kurbelwelle und Schwungrad wandeln Hub in Drehung" 2.5
      camera view=25,10 zoom=1.8 on=kurbelwelle
      spin kurbelwelle turns=6 axis=x
      osc kolben_rechts by=0,-0.14,0 cycles=4 phase=0
      osc kolben_links by=0,-0.14,0 cycles=4 phase=0.5

    step "Nockenwelle steuert Ventile und Kipphebel" 2.5
      camera view=-30,25 zoom=1.9 on=nockenwelle
      spin nockenwelle turns=6 axis=x
      osc ventilstell_e by=0,-0.05,0 cycles=4 phase=0
      osc ventilstell_i by=0,-0.05,0 cycles=4 phase=0.5
      swing kipphebel_e deg=8 axis=x pivot=0,0.5,0.15 cycles=4
      swing kipphebel_i deg=-8 axis=x pivot=0,0.5,-0.15 cycles=4

    step "Ansaugung und Abgas kommen dazu" 2.8
      camera view=35,18 zoom=1.4 on=whole
      show ansauggung
      move ansauggung from=0,0.5,0
      show zuendung
      move zuendung from=0,0.4,0
      spin kurbelwelle turns=5 axis=x
      spin nockenwelle turns=5 axis=x
      osc kolben_rechts by=0,-0.14,0 cycles=4 phase=0
      osc kolben_links by=0,-0.14,0 cycles=4 phase=0.5

    step "Der laufende V8 – alle Teile im Zusammenspiel" 2.5
      camera view=40,22 zoom=1 on=whole
      spin kurbelwelle turns=4 axis=x
      spin nockenwelle turns=4 axis=x
      osc kolben_rechts by=0,-0.14,0 cycles=3 phase=0
      osc kolben_links by=0,-0.14,0 cycles=3 phase=0.5
      osc ventilstell_e by=0,-0.05,0 cycles=3 phase=0
      osc ventilstell_i by=0,-0.05,0 cycles=3 phase=0.5
