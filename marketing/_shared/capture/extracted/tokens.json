    {
      "selector": "section",
      "type": "hero",
      "x": 260,
      "y": 56,
      "width": 1400,
      "height": 1024,
      "heading": "One private chat. Many worlds.",
      "backgroundColor": "#FDFBF7",
      "callsToAction": [
        "Download for Mac / Windows / Linux",
        "Web App →",
        "Private",
