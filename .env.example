# Agents compile-time environment.
#
# Every build reads this file: `--dart-define-from-file=.env`.
#   Android : scripts/build_apk.sh              (arm64 + adb install)
#   Linux   : flutter build linux --release --dart-define-from-file=.env
#   Dev     : flutter run -d linux --dart-define-from-file=.env
#
# A build without this file installs and then shows a dead app: no Supabase
# session, no Agents mode. Keys read by the code live in lib/supabase_config.dart
# and lib/platform_config.dart.

# --- Supabase (required) ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<publishable-anon-key>

# --- Features (required for Agents; defaults in lib/platform_config.dart) ---
FEATURE_AGENTS=true
FEATURE_SKILLS=true
FEATURE_SERVER_TOOLS=true
FEATURE_MCP=true
FEATURE_WORKSPACES=true
FEATURE_ARTIFACTS=true
FEATURE_ARTIFACT_HOSTING=true
FEATURE_PAYMENTS_DIRECT=true
FEATURE_VOICE_MODE=false

# --- Voice call (owner-only test, FEATURE_VOICE_CALL; default off) ---
# The token server that mints the LiveKit room token and dispatches the
# `chuk-voice` worker (POST JSON, see lib/voice/voice_protocol.dart). Private:
# keep the real URL in your gitignored .env only. Empty = no call button.
VOICE_TOKEN_URL=

# --- Desktop only (ignored on Android) ---
FEATURE_SYSTEM_TRAY=true
FEATURE_LINUX_KEYRING=false
