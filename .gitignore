.pseudomap/index.json

# --- Agents ----------------------------------------------------------------
# Golden-diff output from a failing image comparison (flutter_test writes it
# next to the test); never committed.
test/**/failures/

# Python subsystems under agents/
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
agents/**/dist/
agents/**/build/

# SQLite runtime files of the host/manager (upstream already ignores *.db)
*.db-wal
*.db-shm

.env.live

# Host boot log written by agents/host/ on every start; not source. `.prev` is
# the previous boot, rotated by the same writer.
.hostlive
.hostlive.prev

# Claude Code session id files (never commit)
**/session.txt

# Loose verification scratch a session dropped in the root instead of `_scratch/`.
_scratch_*
