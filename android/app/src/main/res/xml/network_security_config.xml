<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Network Security Configuration for chuk.chat

        This provides OS-level security in addition to Dio certificate pinning.
        Certificate pinning is handled in Dart code (lib/utils/certificate_pinning.dart)
    -->

    <!-- Base config: Block all cleartext (HTTP) traffic, only allow HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system CAs only -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Loopback exception. Android blocks cleartext HTTP from targetSdk 28 on,
      and the WebView obeys that policy. The agent's-screen viewer is served by
      a loopback server inside this very process (lib/widgets/vnc_local_server.dart),
      so its page load and its RFB WebSocket are plain http:// and ws:// to
      127.0.0.1. Without this the WebView shows a blank page and the socket
      never opens.

      The exception is as narrow as it can be: loopback only, so nothing leaves
      the device in the clear. Every other destination keeps the base config
      above, which refuses cleartext.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- Debug builds: Allow user-installed certificates for testing -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
