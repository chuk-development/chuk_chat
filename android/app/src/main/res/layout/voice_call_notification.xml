<?xml version="1.0" encoding="utf-8"?>
<!-- Ongoing-call notification, collapsed (VoiceCallBridge.kt). The name and
     status, then Mute, Speaker and Hang up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/voice_call_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

        <TextView
            android:id="@+id/voice_call_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/voice_call_mute"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/voice_call_button"
        android:contentDescription="@string/voice_call_mute"
        android:scaleType="center"
        android:src="@drawable/ic_voice_call_mic" />

    <ImageButton
        android:id="@+id/voice_call_speaker"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/voice_call_button"
        android:contentDescription="@string/voice_call_speaker_on"
        android:scaleType="center"
        android:src="@drawable/ic_voice_call_speaker" />

    <ImageButton
        android:id="@+id/voice_call_hangup"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/voice_call_button_hangup"
        android:contentDescription="@string/voice_call_hang_up"
        android:scaleType="center"
        android:src="@drawable/ic_voice_call_end" />
</LinearLayout>
