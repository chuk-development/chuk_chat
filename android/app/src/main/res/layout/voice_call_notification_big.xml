<?xml version="1.0" encoding="utf-8"?>
<!-- Two large, labelled ongoing-call actions; Android supplies the app header. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="4dp">
    <TextView android:id="@+id/voice_call_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    <TextView android:id="@+id/voice_call_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/voice_call_mute"
            android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:gravity="center"
            android:orientation="horizontal" android:background="@drawable/voice_call_action"
            android:contentDescription="@string/voice_call_mute">
            <ImageView android:id="@+id/voice_call_mute_icon"
                android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_voice_call_mic" android:importantForAccessibility="no" />
            <TextView android:id="@+id/voice_call_mute_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="@string/voice_call_mute"
                android:textColor="@color/voice_call_icon" android:textSize="14sp"
                android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/voice_call_hangup"
            android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
            android:layout_marginStart="6dp" android:gravity="center"
            android:orientation="horizontal" android:background="@drawable/voice_call_action_hangup"
            android:contentDescription="@string/voice_call_hang_up">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_voice_call_end" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="@string/voice_call_hang_up"
                android:textColor="@color/voice_call_on_hangup" android:textSize="14sp"
                android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
