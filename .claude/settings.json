{
  "enabledPlugins": {
    "coderabbit@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pseudomap hook session --slim"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pseudomap hook post-edit"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ]
  }
}
