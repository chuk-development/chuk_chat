# Agents agent image, browser variant (§8, §9).
#
# The base image (`Dockerfile`) deliberately has no browser: Chromium plus the
# X/GTK/font libraries it links against is several hundred MB, and most agents
# never browse. §8 makes that the normal case — a hand-built API tool first,
# the browser only as the fallback. So the browser stack lives here, in a
# variant built ON TOP of the base image, and an agent that never browses does
# not download it.
#
# Why a separate file instead of a second stage in `Dockerfile`:
# `docker build` without `--target` builds the LAST stage of a Dockerfile.
# Appending a browser stage there would silently turn the default build — the
# one `scripts/install.sh` runs — into the heavy one. A separate file keeps the
# default cheap and makes the choice explicit at the command line.
#
# Build (base image first, then this):
#
#     docker build -t agents-base:latest    -f sandbox/docker/Dockerfile    sandbox/docker
#     docker build -t agents-browser:latest -f sandbox/docker/Dockerfile.browser sandbox/docker
#
# Use it for one agent:
#
#     AGENTS_SANDBOX_IMAGE=agents-browser:latest
#
# Why Playwright installs the browser when browser-use does not depend on
# Playwright: browser-use 0.13.7 drives Chromium over the DevTools Protocol
# (`cdp-use`), and its own `browser-use install` command shells out to
# `uvx playwright install chromium --with-deps --no-shell`
# (browser_use/cli.py::_run_install_command). Playwright is the *downloader*
# here, not the driver — this image does exactly what the library's own
# installer does, at build time instead of at first use, so no agent run pays
# for the download (184 MiB, verified in a throwaway container: it yields
# "Google Chrome for Testing 151.0.7922.34").
#
# browser-use finds the result without configuration: its
# `_find_installed_browser_path` searches
# `$PLAYWRIGHT_BROWSERS_PATH/chromium-*/chrome-linux*/chrome` and
# `/usr/local/bin/chromium`, and both point at the same binary here. The same
# path is exported as AGENTS_BROWSER_EXECUTABLE for the agent runtime's own probe
# (`chuk_agents_runtime.browser.find_chromium`).

ARG BASE_IMAGE=agents-base:latest
FROM ${BASE_IMAGE}

# Pinned like every other tool in the base image, so two builds install the same
# Chromium. Playwright's revision is a function of its own version.
ARG PLAYWRIGHT_VERSION=1.62.0

# Outside the user's home so the browser is shared, readable by any uid the
# entrypoint remaps `agents` to, and not lost when a home directory is remapped.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    DEBIAN_FRONTEND=noninteractive

USER root

# `--with-deps` is the reason this runs as root: it apt-installs the shared
# libraries Chromium links against (fonts, GTK, libnss, libdrm, ...). Without it
# the binary is present and exits immediately with a missing-library error.
#
# `/opt/chromium-path` records which build the symlink points at, so
# `docker run <image> cat /opt/chromium-path` answers "which Chromium is in
# here" without repeating the glob. `--version` at the end is the build-time
# proof that the libraries are complete.
RUN set -eux; \
    mkdir -p "${PLAYWRIGHT_BROWSERS_PATH}"; \
    apt-get update; \
    uvx --from "playwright==${PLAYWRIGHT_VERSION}" playwright install chromium --with-deps --no-shell; \
    rm -rf /var/lib/apt/lists/* /root/.cache/uv; \
    chrome="$(find "${PLAYWRIGHT_BROWSERS_PATH}" -type f -name chrome -path '*chrome-linux*' | sort | tail -n 1)"; \
    test -n "${chrome}"; \
    ln -sf "${chrome}" /usr/local/bin/chromium; \
    chmod -R a+rX "${PLAYWRIGHT_BROWSERS_PATH}"; \
    printf '%s\n' "${chrome}" > /opt/chromium-path; \
    "${chrome}" --version

# The stable name for the binary, for the runtime's `check_fn` and for
# browser-use's `executable_path`. It is an ENV and not a profile.d script on
# purpose: commands arrive as non-interactive `docker exec ... bash -c`, which
# reads neither /etc/profile.d nor ~/.bashrc — a value set there is invisible to
# every command the agent runs. `/usr/local/bin/chromium` is also one of the
# paths browser-use's own search walks, so both agree without configuration.
ENV AGENTS_BROWSER_EXECUTABLE=/usr/local/bin/chromium

# A container gives Chromium no CAP_SYS_ADMIN, so its own sandbox cannot start;
# the container is the isolation boundary instead. The agent runtime says the
# same thing in code (`chromium_sandbox=False`), and this marker is what
# browser-use's own `CONFIG.IN_DOCKER` check reads.
ENV IN_DOCKER=true \
    AGENTS_BROWSER_VARIANT=1

# No telemetry and no cloud sync from a user's machine: browser-use defaults
# ANONYMIZED_TELEMETRY to true and lets BROWSER_USE_CLOUD_SYNC follow it
# (browser_use/config.py). The runtime sets these too; setting them in the image
# covers a manual `python -c 'import browser_use'` inside the container.
ENV ANONYMIZED_TELEMETRY=false \
    BROWSER_USE_CLOUD_SYNC=false \
    BROWSER_USE_VERSION_CHECK=false

# Node.js — the runtime for the official Playwright MCP server (`@playwright/mcp`,
# a Node package the agent drives over stdio, §9.1). It doubles as the general
# JavaScript runtime in the box, the way Python is already here. NodeSource LTS
# (22.x) rather than the older apt nodejs, so npm and node agree. (Node, not Bun:
# @playwright/mcp, playwright-core and the MCP SDK are built and tested against
# Node; Bun buys only faster cold start, irrelevant for a long-lived server.)
ARG NODE_MAJOR=22
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends nodejs; \
    rm -rf /var/lib/apt/lists/*; \
    node --version; \
    npm --version

# The Playwright MCP server, pinned and installed globally so no agent run pays a
# cold `npx` download. Driven over stdio, headed by default → it renders to the
# Xvfb display the user watches over VNC, using the single Chromium installed
# above (via `--executable-path` in the seeded mcp.json). See §9.1.
ARG PLAYWRIGHT_MCP_VERSION=0.0.80
RUN set -eux; \
    npm install -g "@playwright/mcp@${PLAYWRIGHT_MCP_VERSION}"; \
    npm cache clean --force; \
    playwright-mcp --version

# Xvfb + x11vnc: the headful Chromium runs on a virtual framebuffer (no real
# screen, no window on anyone's device), and x11vnc serves that display so the
# user can watch and take control over the sealed E2E channel (§9 login hand-off,
# §9.1 renderer path 3). Both are plain apt packages. The startup wiring (which
# display, on-demand vs entrypoint) lives with the runtime, not baked here.
#
# dmz-cursor-theme is here for the WATCHER, not for the browser. Without a
# cursor theme installed, libXcursor has nothing to load and Chromium falls back
# to the X core cursor font, whose glyphs are a fixed 10x16 pixels. x11vnc sends
# that real pointer (measured: a RichCursor rectangle of exactly 10x16), and on
# a 1280x800 screen scaled onto a phone it is all but invisible — the user asked
# to SEE the agent's mouse. With this theme and XCURSOR_SIZE (set by the
# launcher) the same pointer arrives as 48x48. It is a ~600 KB package of
# cursor bitmaps; no daemon, no dependency.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        x11-utils \
        xauth \
        xdotool \
        socat \
        dmz-cursor-theme; \
    rm -rf /var/lib/apt/lists/*

# The display the browser view uses. Not exported globally (a stray DISPLAY makes
# unrelated GUI calls fail when no server is up); the launcher passes it to the
# Playwright MCP process, and the VNC bringup uses the same value.
ENV AGENTS_BROWSER_DISPLAY=:99 \
    PLAYWRIGHT_MCP_VERSION=${PLAYWRIGHT_MCP_VERSION}

# In-container helpers (§9.1): the launcher brings up Xvfb then supervises the
# headed Playwright MCP server and its browser descendants; vnc-up starts x11vnc
# on demand for the live view. Both are invoked by the host over `docker exec`.
COPY browser-mcp.sh /usr/local/bin/agents-browser-mcp
COPY browser-mcp-owner.py /usr/local/lib/agents/browser-mcp-owner.py
COPY vnc-up.sh /usr/local/bin/agents-vnc-up
RUN chmod 0755 /usr/local/bin/agents-browser-mcp /usr/local/bin/agents-vnc-up

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/agents-entrypoint"]
CMD ["sleep", "infinity"]
